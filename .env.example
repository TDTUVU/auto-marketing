# OpenAI API
OPENAI_API_KEY=sk-proj-...

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/marketing?retryWrites=true&w=majority

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Session encryption (32-byte hex — generate: openssl rand -hex 32)
SESSION_ENCRYPT_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Timezone — toàn app hiển thị & lên lịch theo giờ Việt Nam (GMT+7).
# QUAN TRỌNG: phải set biến này ở cả Railway (web) để giờ hiển thị không bị lệch UTC.
TZ=Asia/Ho_Chi_Minh

# Worker tuning (tùy chọn — bỏ trống thì dùng default trong code)
# Chu kỳ poll comment để auto-reply, mặc định 900000 (15 phút). Tăng nếu cạn port
# (net::ERR_ADDRESS_IN_USE) do track nhiều bài; giảm nếu cần auto-reply nhanh hơn.
COMMENT_POLL_EVERY_MS=900000
# Hạn tối đa cho 1 lần đăng (Facebook/X), mặc định 180000 (3 phút).
POST_JOB_TIMEOUT_MS=180000
