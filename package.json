{
  "name": "social-automation",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:all": "NODE_ENV=production pnpm --filter @automation/core build && NODE_ENV=production pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "start:worker": "pnpm --filter web worker",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:post": "tsx scripts/test_post.ts",
    "worker": "pnpm --filter @automation/core build && tsx --env-file=.env apps/web/worker.ts"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
